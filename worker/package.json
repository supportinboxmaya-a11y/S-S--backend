{
  "name": "loops-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production",
    "d1:create": "wrangler d1 create loops-db",
    "d1:migrate": "wrangler d1 migrations apply loops-db",
    "d1:migrate:local": "wrangler d1 migrations apply loops-db --local",
    "d1:execute": "wrangler d1 execute loops-db",
    "kv:create": "wrangler kv:namespace create",
    "kv:create:cache": "wrangler kv:namespace create CACHE",
    "kv:create:sessions": "wrangler kv:namespace create SESSIONS",
    "kv:create:ratelimit": "wrangler kv:namespace create RATE_LIMIT",
    "r2:create": "wrangler r2 bucket create mayastore",
    "queue:create": "wrangler queues create",
    "secret:put": "wrangler secret put",
    "types": "wrangler types",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "zod": "^3.23.0",
    "hono-rate-limiter": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240820.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.70.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}